            "scrollWidth": 318,
            "overflowX": "auto",
            "text": "cd ../shop-app\ngit switch main\n\ngit merge --no-ff feat/home-copy\nnpm test\n\ngit merge --no-ff docs/agent-rule\nnpm test"
